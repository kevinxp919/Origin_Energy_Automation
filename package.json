{
  "name": "origin-energy-automation",
  "version": "1.0.0",
  "description": "Playwright automation tests for Origin Energy website",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:ui": "playwright test --ui",
    "test:pricing": "playwright test tests/e2e/pricing.spec.ts",
    "report": "playwright show-report",
    "test:docker": "docker run --rm -v $(pwd):/workspace -w /workspace origin-energy-automation npm test"
  },
  "keywords": [
    "playwright",
    "automation",
    "testing",
    "origin-energy"
  ],
  "author": "Kevin Cai",
  "license": "MIT",
  "dependencies": {
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
